// =================================================================================================
// DATABASE SCHEMA: every table of EduPlatform, in one file.
//
// How to change it:
//   1. edit this file
//   2. npm run db:migration -- <what_changed>     → writes prisma/migrations/<date>_<what_changed>/migration.sql
//   3. if you added a table with organization_id, add its row-security policy to that SQL file
//      (copy the pattern from the first migration)
//   4. npm run db:migrate                       → applies it to your database
//
// Naming: models are PascalCase here (Organization); tables and columns are snake_case in
// PostgreSQL (organizations, organization_id) through @@map / @map.
// =================================================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The app connects as edu_app: a limited role that row security applies to.
  url       = env("DATABASE_URL")
  // Migrations connect as edu_owner, the only role allowed to change tables.
  directUrl = env("DIRECT_DATABASE_URL")
}

// -------------------------------------------------------------------------------------------------
// SUPER ADMIN SIDE: EduPlatform staff who manage all organizations.
// -------------------------------------------------------------------------------------------------

/// People at EduPlatform who use the super admin console. Not part of any organization.
model SuperAdmin {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("super_admins")
}

/// The modules an organization can be given (Students, Attendance, ...). Filled by prisma/seed.ts.
model Module {
  key         String   @id // e.g. "students"
  name        String
  description String
  /// Modules that must be switched on first, e.g. attendance needs ["academic", "students"].
  dependsOn   String[] @map("depends_on")
  sortOrder   Int      @default(0) @map("sort_order")

  organizations OrganizationModule[]

  @@map("modules")
}

/// The PREDEFINED ROLES (Director, Principal, ...), managed by the super admin. Every
/// organization gets a copy of each (Role.templateKey) that stays in line with this one.
/// Created from src/modules/roles/predefined-roles.ts when the app starts.
model RoleTemplate {
  key         String   @id // e.g. "principal"
  name        String
  description String
  permissions String[]
  /// false for Parent and Student: those logins come from a student's record, not the Users page.
  assignable  Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roles Role[]

  @@map("role_templates")
}

// -------------------------------------------------------------------------------------------------
// TENANTS: an organization (a school group, a college society, ...) and everything it owns.
// Every table below has organization_id, and row security keeps organizations apart.
// -------------------------------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED // its users can't log in; data is kept
}

/// A customer of EduPlatform: one organization = one tenant. It can run several institutions.
model Organization {
  id           String             @id @default(uuid(7)) @db.Uuid
  name         String
  /// Short unique name, e.g. "sri-vidya". Lowercase letters, digits and dashes.
  slug         String             @unique
  contactName  String?            @map("contact_name")
  contactEmail String?            @map("contact_email")
  contactPhone String?            @map("contact_phone")
  status       OrganizationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  modules      OrganizationModule[]
  institutions Institution[]
  campuses     Campus[]
  roles        Role[]
  users        User[]
  userRoles    UserRole[]

  academicYears AcademicYear[]
  classLevels   ClassLevel[]
  classes       Class[]
  batches       Batch[]
  subjects      Subject[]
  classSubjects ClassSubject[]
  holidays      Holiday[]

  students           Student[]
  studentStatuses    StudentStatusChange[]
  promotionRuns      PromotionRun[]
  attendanceRecords  AttendanceRecord[]
  storedFiles        StoredFile[]
  documentTypes      DocumentType[]
  studentDocuments   StudentDocument[]
  admissionSequences AdmissionSequence[]
  guardians          Guardian[]
  studentGuardians   StudentGuardian[]
  enrolments         Enrolment[]

  @@map("organizations")
}

/// Which modules the super admin switched on for an organization.
model OrganizationModule {
  organizationId String   @map("organization_id") @db.Uuid
  moduleKey      String   @map("module_key")
  enabled        Boolean  @default(true)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  module       Module       @relation(fields: [moduleKey], references: [key])

  @@id([organizationId, moduleKey])
  @@map("organization_modules")
}

/// Whether a campus or institution is in use (ADR-0026). An INACTIVE one keeps its records, which
/// can still be read, but nothing new happens there; it is never deleted while it has data.
enum PlaceStatus {
  ACTIVE
  INACTIVE
}

/// A college or school of the organization, e.g. "Sri Vidya Junior College". Only the super admin
/// adds or deletes institutions (ADR-0025); there is no type: each sets up its own class levels.
model Institution {
  id                       String      @id @default(uuid(7)) @db.Uuid
  organizationId           String      @map("organization_id") @db.Uuid
  name                     String
  /// Short code, unique inside the organization, e.g. "SVJC".
  code                     String
  /// Only the super admin deactivates and activates an institution (ADR-0026).
  status                   PlaceStatus @default(ACTIVE)
  /// Days without classes every week (Academic module): 0 = Sunday ... 6 = Saturday.
  weeklyOffDays            Int[]       @default([0]) @map("weekly_off_days")
  /// Students module: how admission numbers are made when left empty, e.g. "{CODE}{YY}{SEQ:4}"
  /// -> "SVJC260001". Empty = numbers are typed by hand.
  admissionNoPattern       String?     @map("admission_no_pattern")
  /// The institution's time zone: decides what "today" is (attendance), e.g. "Asia/Kolkata".
  timeZone                 String      @default("Asia/Kolkata") @map("time_zone")
  /// Attendance: how many days back a past day may still be marked or corrected.
  attendanceCorrectionDays Int         @default(7) @map("attendance_correction_days")
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  campuses     Campus[]
  userRoles    UserRole[]

  academicYears      AcademicYear[]
  classLevels        ClassLevel[]
  classes            Class[]
  batches            Batch[]
  subjects           Subject[]
  holidays           Holiday[]
  students           Student[]
  enrolments         Enrolment[]
  admissionSequences AdmissionSequence[]
  documentTypes      DocumentType[]

  @@unique([organizationId, code])
  @@map("institutions")
}

/// A physical location of an institution, e.g. "Kukatpally".
model Campus {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  institutionId  String      @map("institution_id") @db.Uuid
  name           String
  code           String
  /// INACTIVE = closed (ADR-0026); only the Organization admin activates it again.
  status         PlaceStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  institution  Institution  @relation(fields: [institutionId], references: [id])
  userRoles    UserRole[]
  classes      Class[]
  holidays     Holiday[]
  students     Student[]
  enrolments   Enrolment[]

  @@unique([institutionId, code])
  @@index([organizationId])
  @@map("campuses")
}

/// A set of permissions, e.g. "Organization admin" or "Teacher". Each organization has its own.
model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  /// Permission keys, e.g. ["access.user.view", "platform.institution.manage"].
  /// The full list is in src/modules/roles/permissions.ts.
  permissions    String[]
  /// Set for a predefined role (copy of a RoleTemplate): only the super admin can change it.
  /// Empty for the organization's own roles.
  templateKey    String?  @map("template_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id])
  template     RoleTemplate? @relation(fields: [templateKey], references: [key], onDelete: Restrict)
  users        UserRole[]

  @@unique([organizationId, name])
  @@unique([organizationId, templateKey])
  @@map("roles")
}

/// STAFF works in the web app with roles; PARENT and STUDENT use the portal and only see the
/// students they are linked to (ADR-0022).
enum UserKind {
  STAFF
  PARENT
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE // can't log in
}

/// A person who logs in to an organization: admins, office staff, teachers.
model User {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String
  /// Login email, unique across EduPlatform.
  email          String     @unique
  passwordHash   String     @map("password_hash")
  status         UserStatus @default(ACTIVE)
  kind           UserKind   @default(STAFF)
  /// A parent's login: the guardian record (they see all of that guardian's children).
  guardianId     String?    @unique @map("guardian_id") @db.Uuid
  /// A student's login: their own record.
  studentId      String?    @unique @map("student_id") @db.Uuid
  lastLoginAt    DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  roles        UserRole[]
  guardian     Guardian?    @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("users")
}

/// Which roles a user has, and WHERE each one applies (a "role assignment"):
///   no institution, no campus  -> the whole organization
///   institutionId only         -> one institution and all its campuses
///   campusId (+ institutionId) -> one campus only
/// A user can have several, e.g. Principal of an institution AND Senior faculty at two
/// campuses. They may do what each role allows, in that role's place.
model UserRole {
  id             String  @id @default(uuid(7)) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  roleId         String  @map("role_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  institutionId  String? @map("institution_id") @db.Uuid
  campusId       String? @map("campus_id") @db.Uuid

  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roleId])
  @@index([organizationId])
  @@index([institutionId])
  @@index([campusId])
  @@map("user_roles")
}

/// Who changed what, and when. Written by AuditService for every create, update and delete.
/// Add-only: the app can't change or delete entries (ADR-0027).
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// The organization the change belongs to (empty for super admin actions on the platform).
  organizationId String?  @map("organization_id") @db.Uuid
  actorType      String   @map("actor_type") // "super_admin", "user" or "unknown" (failed login)
  /// Empty only for a failed login with an unknown email.
  actorId        String?  @map("actor_id") @db.Uuid
  /// The person's name at the time of the change, so the log reads "Ravi Kumar", not an id.
  actorName      String?  @map("actor_name")
  /// Where the change happened, so campus and institution admins see their own part of the log.
  /// Kept as plain ids (no foreign key): the log stays even if the campus is deleted.
  institutionId  String?  @map("institution_id") @db.Uuid
  campusId       String?  @map("campus_id") @db.Uuid
  action         String // e.g. "create", "update", "delete", "suspend"
  entity         String // e.g. "institution"
  entityId       String?  @map("entity_id")
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------------------------------------------------
// ACADEMIC MODULE (ADR-0019): academic years, class levels and classes, batches.
// Only for organizations that have the Academic module switched on.
// -------------------------------------------------------------------------------------------------

enum AcademicYearStatus {
  PLANNED
  ACTIVE
  CLOSED
}

/// An institution's academic year, e.g. "2026-27" from 1 June 2026 to 31 March 2027.
/// At most one is ACTIVE per institution; years of one institution don't overlap.
model AcademicYear {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  institutionId  String             @map("institution_id") @db.Uuid
  name           String
  startsOn       DateTime           @map("starts_on") @db.Date
  endsOn         DateTime           @map("ends_on") @db.Date
  status         AcademicYearStatus @default(PLANNED)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  institution  Institution  @relation(fields: [institutionId], references: [id])
  enrolments   Enrolment[]

  @@unique([institutionId, name])
  @@index([organizationId])
  @@map("academic_years")
}

/// The LEVELS of an institution's classes, top to bottom, e.g.
///   junior college:  1 Year   -> 2 Group  -> 3 Section
///   school:          1 Class  -> 2 Section
///   or anything the institution needs, e.g. Type -> Group -> Stream -> Section.
/// The last level is where students are placed (a section). Each institution gets defaults for
/// its type (src/modules/academic/default-levels.ts) and can rename them.
model ClassLevel {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  institutionId  String   @map("institution_id") @db.Uuid
  /// 1 = top level.
  position       Int
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  institution  Institution  @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, position])
  @@index([organizationId])
  @@map("class_levels")
}

/// A class at one level, on one campus: a tree that follows the institution's levels, e.g.
///   1st year (level 1) -> MPC (level 2) -> Section A (level 3).
/// Classes of the last level are the sections students will be placed in.
model Class {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  institutionId  String   @map("institution_id") @db.Uuid
  campusId       String   @map("campus_id") @db.Uuid
  /// Empty for a class of the top level.
  parentId       String?  @map("parent_id") @db.Uuid
  /// Which level this class is at (ClassLevel.position).
  level          Int
  name           String
  /// Short code, unique among its siblings, e.g. "MPC" or "A".
  code           String
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id])
  institution  Institution    @relation(fields: [institutionId], references: [id])
  campus       Campus         @relation(fields: [campusId], references: [id])
  parent       Class?         @relation("ClassTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Class[]        @relation("ClassTree")
  subjects     ClassSubject[]
  enrolments   Enrolment[]

  @@index([organizationId])
  @@index([campusId])
  @@index([parentId])
  @@map("classes")
}

enum BatchStatus {
  ACTIVE
  COMPLETED
}

/// A BATCH: students who joined together and move on together, e.g. "2026-28" or
/// "Long term 2026". `stage` says where the batch is now, in the institution's own words
/// (e.g. "Junior", "Senior", "Long term", "Passed out"); promotion (Students module) moves it on.
model Batch {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  institutionId  String      @map("institution_id") @db.Uuid
  name           String
  code           String
  stage          String
  status         BatchStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  institution  Institution  @relation(fields: [institutionId], references: [id])
  students     Student[]

  @@unique([institutionId, code])
  @@index([organizationId])
  @@map("batches")
}

/// A subject an institution teaches, e.g. Mathematics (MATHS).
model Subject {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  institutionId  String   @map("institution_id") @db.Uuid
  name           String
  code           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id])
  institution  Institution    @relation(fields: [institutionId], references: [id])
  classes      ClassSubject[]

  @@unique([institutionId, code])
  @@index([organizationId])
  @@map("subjects")
}

/// Which subjects a class has. Attached at any level; the classes below inherit them
/// (Maths on "MPC" = Maths in every MPC section).
model ClassSubject {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  class        Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([classId, subjectId])
  @@index([organizationId])
  @@index([subjectId])
  @@map("class_subjects")
}

/// A holiday (one day or a range) for a whole institution, or for one campus only.
model Holiday {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  institutionId  String   @map("institution_id") @db.Uuid
  /// Empty = every campus of the institution.
  campusId       String?  @map("campus_id") @db.Uuid
  name           String
  startsOn       DateTime @map("starts_on") @db.Date
  endsOn         DateTime @map("ends_on") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  institution  Institution  @relation(fields: [institutionId], references: [id])
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([institutionId, startsOn])
  @@map("holidays")
}

// -------------------------------------------------------------------------------------------------
// STUDENTS MODULE (ADR-0020): students, their status history, guardians, enrolments.
// Only for organizations that have the Students module switched on.
// -------------------------------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  DISCONTINUED
  ALUMNI
}

/// A student of an institution, studying at one of its campuses.
model Student {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  institutionId  String        @map("institution_id") @db.Uuid
  /// The campus the student studies at; it decides who may see and change the student.
  campusId       String        @map("campus_id") @db.Uuid
  /// Unique in the institution, e.g. "SVJC260001".
  admissionNo    String        @map("admission_no")
  admissionDate  DateTime      @map("admission_date") @db.Date
  /// As in official records; no forced first / last name split.
  fullName       String        @map("full_name")
  surname        String?
  dateOfBirth    DateTime      @map("date_of_birth") @db.Date
  gender         Gender
  bloodGroup     String?       @map("blood_group")
  phone          String?
  email          String?
  address        String?
  /// The batch the student joined with (Academic module), e.g. "2026-28 batch".
  batchId        String?       @map("batch_id") @db.Uuid
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization          @relation(fields: [organizationId], references: [id])
  institution   Institution           @relation(fields: [institutionId], references: [id])
  campus        Campus                @relation(fields: [campusId], references: [id])
  batch         Batch?                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  statusChanges StudentStatusChange[]
  guardians     StudentGuardian[]
  enrolments    Enrolment[]
  login         User?
  documents     StudentDocument[]

  @@unique([institutionId, admissionNo])
  @@index([organizationId])
  @@index([campusId])
  @@index([batchId])
  @@map("students")
}

/// Every status change of a student, with the date it takes effect and why.
model StudentStatusChange {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  studentId      String         @map("student_id") @db.Uuid
  fromStatus     StudentStatus? @map("from_status")
  toStatus       StudentStatus  @map("to_status")
  effectiveOn    DateTime       @map("effective_on") @db.Date
  reason         String?
  changedBy      String         @map("changed_by") @db.Uuid
  changedAt      DateTime       @default(now()) @map("changed_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentId])
  @@map("student_status_changes")
}

/// A parent or guardian. One guardian can be linked to several students (siblings).
model Guardian {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fullName       String   @map("full_name")
  /// Not unique: parents often share a number.
  phone          String?
  email          String?
  occupation     String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id])
  students     StudentGuardian[]
  login        User?

  @@index([organizationId])
  @@index([organizationId, phone])
  @@map("guardians")
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

/// Which guardians a student has, how they are related, and who is the main contact.
model StudentGuardian {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  guardianId     String           @map("guardian_id") @db.Uuid
  relation       GuardianRelation
  isPrimary      Boolean          @default(false) @map("is_primary")

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian     @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@unique([studentId, guardianId])
  @@index([organizationId])
  @@index([guardianId])
  @@map("student_guardians")
}

enum EnrolmentStatus {
  ACTIVE
  PROMOTED
  COMPLETED
  LEFT
}

/// Which SECTION (a class of the last level) a student is in, in one academic year.
/// One enrolment per student per academic year.
model Enrolment {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  studentId      String          @map("student_id") @db.Uuid
  academicYearId String          @map("academic_year_id") @db.Uuid
  institutionId  String          @map("institution_id") @db.Uuid
  campusId       String          @map("campus_id") @db.Uuid
  classId        String          @map("class_id") @db.Uuid
  rollNo         String?         @map("roll_no")
  status         EnrolmentStatus @default(ACTIVE)
  enrolledOn     DateTime        @map("enrolled_on") @db.Date
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  institution  Institution  @relation(fields: [institutionId], references: [id])
  campus       Campus       @relation(fields: [campusId], references: [id])
  class        Class        @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([organizationId])
  @@index([classId, academicYearId])
  @@map("enrolments")
}

/// The next number of an institution's admission-number pattern, per period: "2026" when the
/// pattern restarts every year ({YY} / {YYYY}), "" when it never restarts.
model AdmissionSequence {
  organizationId String @map("organization_id") @db.Uuid
  institutionId  String @map("institution_id") @db.Uuid
  period         String
  nextValue      Int    @default(1) @map("next_value")

  organization Organization @relation(fields: [organizationId], references: [id])
  institution  Institution  @relation(fields: [institutionId], references: [id])

  @@id([institutionId, period])
  @@index([organizationId])
  @@map("admission_sequences")
}

/// One applied promotion (Students module): what it changed, so it can be UNDONE.
/// `items`: [{ studentId, oldEnrolmentId, newEnrolmentId | null (finished) }]
/// `batchStages`: [{ batchId, stage }] the stages the batches had before.
model PromotionRun {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  institutionId  String    @map("institution_id") @db.Uuid
  campusId       String    @map("campus_id") @db.Uuid
  fromYearId     String    @map("from_year_id") @db.Uuid
  toYearId       String    @map("to_year_id") @db.Uuid
  promoted       Int
  graduated      Int
  items          Json
  batchStages    Json      @map("batch_stages")
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  undoneAt       DateTime? @map("undone_at") @db.Timestamptz
  undoneBy       String?   @map("undone_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([campusId, createdAt])
  @@map("promotion_runs")
}

// -------------------------------------------------------------------------------------------------
// ATTENDANCE MODULE (ADR-0021)
// -------------------------------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

/// One student's attendance for one day (period 0 = the whole day) in their section.
/// Records are never overwritten: a change makes a NEW record (isCurrent) that points to the old
/// one (correctedFromId), with a reason; the old one keeps isCurrent = false.
model AttendanceRecord {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  institutionId    String           @map("institution_id") @db.Uuid
  campusId         String           @map("campus_id") @db.Uuid
  /// The section the student was in that day.
  classId          String           @map("class_id") @db.Uuid
  academicYearId   String           @map("academic_year_id") @db.Uuid
  studentId        String           @map("student_id") @db.Uuid
  date             DateTime         @db.Date
  /// 0 = the whole day (period-wise marking later uses 1, 2, ...).
  period           Int              @default(0)
  status           AttendanceStatus
  remark           String?
  isCurrent        Boolean          @default(true) @map("is_current")
  correctedFromId  String?          @map("corrected_from_id") @db.Uuid
  correctionReason String?          @map("correction_reason")
  markedBy         String           @map("marked_by") @db.Uuid
  markedByName     String           @map("marked_by_name")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([classId, date])
  @@index([studentId, date])
  @@map("attendance_records")
}

// -------------------------------------------------------------------------------------------------
// FILES and STUDENT DOCUMENTS (ADR-0023)
// -------------------------------------------------------------------------------------------------

/// An uploaded file. The bytes are in the file storage (src/modules/files) under `storageKey`;
/// this row is what the database knows about them. Only reachable through the API.
model StoredFile {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  originalName   String   @map("original_name")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  /// SHA-256 of the content, to spot duplicates and check integrity.
  sha256         String
  storageKey     String   @unique @map("storage_key")
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id])
  document     StudentDocument?

  @@index([organizationId])
  @@map("stored_files")
}

/// What an institution collects from students, e.g. "Transfer certificate".
model DocumentType {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  institutionId   String   @map("institution_id") @db.Uuid
  name            String
  /// Shown as missing on a student's page until uploaded.
  isRequired      Boolean  @default(false) @map("is_required")
  /// Parents and students may see / download documents of this type in the portal.
  visibleInPortal Boolean  @default(false) @map("visible_in_portal")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id])
  institution  Institution       @relation(fields: [institutionId], references: [id])
  documents    StudentDocument[]

  @@unique([institutionId, name])
  @@index([organizationId])
  @@map("document_types")
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

/// A document of a student: its type, the file, and whether staff verified it.
model StudentDocument {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  studentId      String         @map("student_id") @db.Uuid
  documentTypeId String         @map("document_type_id") @db.Uuid
  fileId         String         @unique @map("file_id") @db.Uuid
  status         DocumentStatus @default(UPLOADED)
  /// e.g. why it was rejected.
  note           String?
  uploadedBy     String         @map("uploaded_by") @db.Uuid
  uploadedByName String         @map("uploaded_by_name")
  verifiedBy     String?        @map("verified_by") @db.Uuid
  verifiedByName String?        @map("verified_by_name")
  verifiedAt     DateTime?      @map("verified_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  file         StoredFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([studentId])
  @@map("student_documents")
}
