# Local settings. Copy this file to .env (same folder) and fill in DATABASE_ADMIN_URL.
# .env is never committed.

# --- Database (your local PostgreSQL 18) ----------------------------------------------------
# A superuser connection, used ONLY by `pnpm db:setup` / `pnpm db:reset` to create the roles
# and the database. Use the password you chose when installing PostgreSQL.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres

# What the app uses (role edu_app: row security keeps organizations apart).
DATABASE_URL=postgres://edu_app:edu_app@localhost:5432/eduplatform

# What migrations use (role edu_owner: the only role allowed to change tables).
DIRECT_DATABASE_URL=postgres://edu_owner:edu_owner@localhost:5432/eduplatform

# --- Login -----------------------------------------------------------------------------------
# Secret used to sign login tokens. Any long random text; different in every environment.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
# How long a login lasts.
JWT_EXPIRES_IN=8h

# The first super admin, created by `pnpm db:seed`. Change the password after first login.
SEED_SUPER_ADMIN_EMAIL=superadmin@eduplatform.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe@12345

# --- API -------------------------------------------------------------------------------------
PORT=3000
# Frontend addresses allowed to call the API from the browser (comma-separated).
CORS_ORIGINS=http://localhost:3001,http://localhost:3003
