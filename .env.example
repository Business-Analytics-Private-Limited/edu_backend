# Local settings. Copy this file to .env (same folder) and fill in DATABASE_ADMIN_URL.
# .env is never committed. Apps, scripts and tests all read it (loadLocalEnv in server-kit).
# Everything except DATABASE_ADMIN_URL has a working local default, so only override what differs.

# --- PostgreSQL (your local install, version 18; ADR-0012) ---------------------------------
# A superuser connection, used ONLY by `pnpm db:setup` and the integration tests to create
# roles and databases. Use the password you chose when installing PostgreSQL.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres

# One connection per database role (ADR-0009). Defaults shown; created by `pnpm db:setup`.
# DATABASE_OWNER_URL=postgres://edu_owner:edu_owner@localhost:5432/eduplatform
# DATABASE_APP_URL=postgres://edu_app:edu_app@localhost:5432/eduplatform
# DATABASE_PLATFORM_URL=postgres://edu_platform:edu_platform@localhost:5432/eduplatform
# DATABASE_RELAY_URL=postgres://edu_relay:edu_relay@localhost:5432/eduplatform
# DATABASE_GATEWAY_URL=postgres://edu_gateway:edu_gateway@localhost:5432/eduplatform

# --- API -----------------------------------------------------------------------------------
# Run only some services (comma-separated keys). Empty = all. See docs/guides/running-one-service.md
# ENABLED_SERVICES=students,academic,identity,files
# PORT=3000
# LOG_LEVEL=info
# SWAGGER_ENABLED=true
# Browser origins allowed to call the API directly (comma-separated). Empty = none.
# CORS_ORIGINS=http://localhost:3001,http://localhost:3003

# --- On hold until Phase 2 (Docker, ADR-0012) ------------------------------------------------
# REDIS_URL=redis://localhost:6379
# KEYCLOAK_URL=http://localhost:8080
# S3_ENDPOINT=http://localhost:9000
