{
  "realm": "platform",
  "displayName": "EduPlatform – platform staff",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(5)",
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    }
  ],
  "smtpServer": {
    "host": "localhost",
    "port": "1025",
    "from": "no-reply@eduplatform.local",
    "fromDisplayName": "EduPlatform (local)"
  },
  "clients": [
    {
      "clientId": "admin",
      "name": "Super admin console",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-admin-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3003/*"],
      "webOrigins": ["http://localhost:3003"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "postman",
      "name": "Postman (local only)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://oauth.pstmn.io/v1/callback"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    }
  ]
}
