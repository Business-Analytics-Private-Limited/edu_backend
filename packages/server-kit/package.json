{
  "name": "@eduplatform/server-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Tenant context, database transactions, guards, outbox, audit and logging for backend apps",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eduplatform/contracts": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "jose": "^6.2.12",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0"
  },
  "devDependencies": {
    "@eduplatform/config": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@types/node": "^22.17.0",
    "@types/pg": "^8.15.5",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
