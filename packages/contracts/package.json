{
  "name": "@eduplatform/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAPI documents, event schemas, generated types and the Postman collection (ADR-0010)",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./dist/openapi.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "lint": "eslint src scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eduplatform/config": "workspace:*",
    "@types/node": "^22.17.0",
    "openapi-to-postmanv2": "^5.0.1",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.2",
    "yaml": "^2.8.1"
  }
}
