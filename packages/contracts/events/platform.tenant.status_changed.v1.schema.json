{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform.tenant.status_changed/1",
  "title": "platform.tenant.status_changed",
  "description": "An organization was activated, suspended or reactivated. Subject: the tenant id. Consumers: identity ends sessions of a suspended tenant.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "from", "to", "reason"],
  "properties": {
    "tenantId": { "type": "string", "format": "uuid" },
    "from": { "enum": ["onboarding", "active", "suspended", "closed"] },
    "to": { "enum": ["onboarding", "active", "suspended", "closed"] },
    "reason": { "type": ["string", "null"] }
  }
}
