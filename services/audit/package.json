{
  "name": "@eduplatform/audit-service",
  "version": "0.1.0",
  "private": true,
  "description": "Audit service: the append-only record of who changed what (docs/modules/audit.md)",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./public": {
      "types": "./dist/public/index.d.ts",
      "default": "./dist/public/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@eduplatform/contracts": "workspace:*",
    "@eduplatform/server-kit": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.0"
  },
  "devDependencies": {
    "@eduplatform/config": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@types/node": "^22.17.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
